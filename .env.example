APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peluangku
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_ENCRYPT_HISTORY=true

# ---------------------------------------------------------------------------
# SatuBeasiswa — scholarship source (satubeasiswa.kemdiktisaintek.go.id)
# ---------------------------------------------------------------------------
# The national portal is read directly: its listing pages are server-rendered
# and already embed the scholarship data, so no scraper service and no API
# token are needed. These defaults match the live site.
SATUBEASISWA_BASE_URL=https://satubeasiswa.kemdiktisaintek.go.id
SATUBEASISWA_START_URL=https://satubeasiswa.kemdiktisaintek.go.id/beasiswa

# Peluangku only recommends study in Indonesia.
SATUBEASISWA_DOMESTIC_ONLY=true

# Seconds before one page request is considered dead.
SATUBEASISWA_TIMEOUT=30

# Hard cap on pages per run. 0 = walk every page the site reports (currently 12).
SATUBEASISWA_MAX_PAGES=0

SATUBEASISWA_USER_AGENT="Peluangku/1.0 (+https://github.com/DoniiAdityaa/peluangku)"
